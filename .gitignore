*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 2. Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# 3. Datasets & Raw Media (STRICTLY DO NOT PUSH TO GITHUB)
*.mp4
*.avi
*.mkv
*.mov
*.wmv
*.flv
*.webm

*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

DataSets/raw/*
